rules_version = '2';

// Each signed-in user can only read and write their own data:
//   users/{uid}                 profile (name, email, phone, country, flags)
//   users/{uid}/quizzes/{id}    quizzes they created
//   users/{uid}/attempts/{id}   their quiz results
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;

      match /quizzes/{quizId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
      }
      match /attempts/{attemptId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
